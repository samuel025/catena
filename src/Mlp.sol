            [int256(0), -int256(42), int256(0), -int256(173), int256(0), int256(0)],
            [int256(0), -int256(876), int256(45), -int256(17), int256(817), int256(0)],
            [int256(2), -int256(844), int256(352), -int256(134), int256(35), int256(0)],
            [int256(824), -int256(721), int256(0), -int256(16), int256(0), int256(0)],
            [int256(2), -int256(711), int256(272), -int256(150), int256(29), int256(0)],
            [int256(0), -int256(290), int256(0), -int256(61), int256(0), int256(0)]
