        int256[8] memory b1 = [int256(666), -int256(61), -int256(11), int256(0), int256(744), int256(10), int256(644), -int256(69)];
        int256[8] memory w2 = [int256(213), int256(0), int256(0), int256(103), int256(292), int256(164), int256(176), int256(133)];
        int256 acc;
        for (uint256 j; j < 8; ++j) {
            int256 z;
            for (uint256 i; i < 6; ++i) {
                int256 xi = x[i];
                if (xi < 0) xi = 0; // inputs are clamped, so extreme values cannot overflow
                if (xi > SCALE) xi = SCALE;
                z += w1[j][i] * xi;
            }
            z = (z >> SHIFT) + b1[j];
            if (z > 0) acc += w2[j] * z;
        }
        int256 out = (acc >> SHIFT) + 51;
        if (out < 0) return 0;
        if (out > SCALE) return uint256(SCALE);
